<div class="divider">
  <div class="diamond"></div>
  <div class="diamond"></div>
  <div class="diamond"></div>
</div>

<style>
  .divider {
    position: relative;
    z-index: 10;
    max-width: 640px;
    margin: 0 auto;
    padding: 1.8rem 2rem 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .diamond {
    width: 4px;
    height: 4px;
    background: var(--sand-dim);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
</style>
